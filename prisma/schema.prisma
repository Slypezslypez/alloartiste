generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  category     String
  city         String   @default("")
  bio          String   @default("")
  tagline      String? // courte citation en italique affichée sur le profil
  services     String[] @default([]) // formules & prestations (max 6, suggérées par IA)
  photos       String[] @default([]) // max 5, contrôlé côté application
  videos       String[] @default([]) // max 5, contrôlé côté application

  phone     String?
  website   String?
  facebook  String?
  instagram String?

  rating       Float   @default(0)
  reviewsCount Int     @default(0)
  views        Int     @default(0)
  isVerified   Boolean @default(false)

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active | trialing | past_due | canceled | incomplete | unpaid
  currentPeriodEnd     DateTime? // fin de la période payée en cours

  leads Lead[]

  termsAcceptedAt DateTime? // date d'acceptation des CGU (preuve, lors de l'abonnement)

  resetTokenHash String?   @unique // empreinte du jeton de réinitialisation (jamais le jeton en clair)
  resetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([city])
}

model Lead {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  senderName  String
  senderEmail String
  senderPhone String?
  eventDate   String?
  message     String
  status      String   @default("new") // new | replied | archived
  createdAt   DateTime @default(now())

  @@index([artistId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  role      String   @default("organisateur") // organisateur | artiste | autre
  message   String
  status    String   @default("new") // new | replied | archived
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  category  String   @default("Conseils")
  body      String // paragraphes séparés par une ligne vide
  imageUrl  String? // si présent, prime sur l'icône/dégradé
  imagePositionX Int @default(50) // point focal du recadrage, en % (0-100)
  imagePositionY Int @default(50)
  icon      String   @default("📰")
  gradient  String   @default("linear-gradient(135deg, #d4af37, #8b6b1f)")
  readTime  String   @default("4 min")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id String @id @default("singleton")

  // Identité
  siteName  String @default("AlloArtiste")
  logoPart1 String @default("ALLO")
  logoPart2 String @default("ARTISTE")
  tagline   String @default("Plateforme de mise en relation entre artistes et organisateurs en Belgique")
  headerBackgroundUrl String? // image de fond du bandeau de menu, modifiable via admin
  headerBackgroundPositionX Int @default(50) // point focal du recadrage, en % (0-100)
  headerBackgroundPositionY Int @default(50)

  // Page d'accueil — texte principal
  heroLine1     String @default("TROUVEZ")
  heroEmphasis  String @default("L'ARTISTE")
  heroLine2     String @default("QU'IL VOUS FAUT")
  heroSubtitle  String @default("Musiciens, danseurs, comédiens, DJs, plasticiens... chaque profil présente jusqu'à 5 photos et 5 vidéos pour se montrer sous son meilleur jour. Contactez directement l'artiste pour un devis.")

  // Statistiques affichées (le nombre d'artistes est calculé automatiquement)
  statCommissionValue String @default("0%")
  statCommissionLabel String @default("Commission")
  statDirectValue      String @default("Direct")
  statDirectLabel      String @default("Organisateur → Artiste")

  // Artistes mis en avant sur l'accueil (vide = sélection automatique)
  spotlightArtistId1 String?
  spotlightArtistId2 String?

  // Carrousel promotionnel sur l'accueil (images ajoutées via admin, max 10, contrôlé côté application)
  promoImages String[] @default([])

  // Page "Comment ça marche" — illustrations optionnelles (modifiables via admin)
  howArtistsImageUrl String?
  howArtistsImagePositionX Int @default(50) // point focal du recadrage, en % (0-100)
  howArtistsImagePositionY Int @default(50)
  howOrganizersImageUrl String?
  howOrganizersImagePositionX Int @default(50)
  howOrganizersImagePositionY Int @default(50)

  // Contact
  contactReceiverEmail String?

  updatedAt DateTime @updatedAt
}
